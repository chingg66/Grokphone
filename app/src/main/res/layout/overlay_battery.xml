<?xml version="1.0" encoding="utf-8"?>
<!--
  電池懸浮窗。由 WindowManager 直接 addView，
  只能用普通 View 體系，不能用 Compose。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlay_battery_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="#A5D6A2"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_battery_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="--"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlay_battery_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="--"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/overlay_battery_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="--"
        android:textColor="#80FFFFFF"
        android:textSize="11sp" />

    <!-- 關閉按鈕：點擊停止服務 -->
    <TextView
        android:id="@+id/overlay_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="#80FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
